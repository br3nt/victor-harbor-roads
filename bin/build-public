def placeholder_page(title: str, text: str) -> str:
    t = html.escape(title)
    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{t} · Victor Harbor roads</title>
<style>
:root {{ --bg: #f4f6f5; --fg: #17262b; --muted: #51636a; --accent: #0b6b88; color-scheme: light dark; }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg: #111a1d; --fg: #e6eef0; --muted: #9fb2b8; --accent: #6cc4de; }} }}
body {{ background: var(--bg); color: var(--fg); font: 17px/1.6 system-ui, -apple-system, sans-serif; margin: 0; }}
main {{ max-width: 40rem; margin: 0 auto; padding: 3rem 16px; }}
a {{ color: var(--accent); }} p {{ color: var(--muted); }}
</style>
</head>
<body>
<main>
<h1>{t}</h1>
<p>{html.escape(text)}</p>
<p><a href="../index.html">← Back to the project home</a></p>
</main>
</body>
</html>
"""


if __name__ == "__main__":
    sys.exit(main())
