ROLE_LABEL = { "chaired-by" => "Chair", "moved-by" => "Moved", "seconded-by" => "Seconded", "decided-by" => "Also present and voting", "absent" => "Apology / absent", "authored-by" => "Report author", "consulted" => "Officers consulted / in attendance", "evidence" => "Documents before the meeting" }
RES.each do |title, date, meeting, summary, record, roles, ids|
  rows = roles.map do |rel, names|
    links = names.map { |n| %(<a rel="#{rel}" href="/n/#{slug.(n)}">#{h.(n)}</a>) }.join(", ")
    %(<tr><th>#{h.(ROLE_LABEL[rel])}</th><td>#{links}</td></tr>)
  end.join("\n")
  body = <<~HTML
    <h1>#{h.(title)}</h1>
    <p><time datetime="#{date}">#{Date.parse(date).strftime("%-d %b %Y") rescue date}</time> — #{h.(meeting)}. Made by the <a rel="related" href="/n/city-of-victor-harbor">City of Victor Harbor</a>.</p>
    <p>#{h.(summary)} #{src.(ids)}</p>
    <table><tbody>
    #{rows}
    </tbody></table>
    <p><strong>Record:</strong> #{h.(record)}</p>
    <p>Part of the <a rel="related" href="/n/decision-timeline">Decision Timeline</a>. Link types: <a rel="describedby" href="/n/vocabulary">Vocabulary</a>.</p>
  HTML
  put(title, body, "decision,council")
end
puts "built #{ORGS.size} organisations, #{PEOPLE.size} people, #{DOCS.size} documents, #{RES.size} resolutions"
