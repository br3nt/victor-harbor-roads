#!/usr/bin/env ruby
# Builds the decision graph (vocabulary, organisations, people, resolutions, key documents)
# from the data below, and loads each as a note via bin/kb. Re-runnable: notes are upserted by title.
# Every fact carries a source id from the Sources Register; see research/B-provenance.md.
Encoding.default_external = Encoding::UTF_8
require "active_support/core_ext/string/inflections"
require "cgi"
require "date"
require "fileutils"
require_relative "acronym_expand"

ROOT = File.expand_path("..", __dir__)
TMP = File.join(ROOT, "tmp-notes", "graph")
FileUtils.mkdir_p(TMP)
h = ->(s) { CGI.escapeHTML(s.to_s) }
slug = ->(title) { title.parameterize }
src = ->(ids) { ids.split(/,\s*(?=S-)/).map { |i| id, loc = i.split(" ", 2); %(<a href="/n/sources-register##{id}">[#{h.(id)}#{loc ? " #{h.(loc)}" : ""}]</a>) }.join(" ") }

def put(title, body, tags)
  path = File.join(TMP, "#{title.parameterize}.html")
  File.write(path, AcronymExpand.expand(body)) # first use of each acronym spelled out per block
  system(File.join(ROOT, "bin", "kb"), "put", title, path, "--tags", tags, out: File::NULL) or abort "kb put failed: #{title}"
end

# ---------------------------------------------------------------- vocabulary
VOCAB = {
  "moved-by" => "The resolution was moved by the target person.",
  "seconded-by" => "The resolution was seconded by the target person.",
  "chaired-by" => "The meeting that made the decision was chaired by the target person.",
  "decided-by" => "The target was a member present and entitled to vote when the decision was made (no division was called, so individual votes are not recorded unless stated).",
  "absent" => "The target member gave an apology or was absent for the decision, as recorded in the minutes.",
  "authored-by" => "The report, document or officer commentary was written by the target (person or organisation).",
  "consulted" => "The target officer is listed as consulted on, or in attendance for, the report.",
  "affiliation" => "The person held a position in the target organisation.",
  "commissioned" => "The organisation engaged the target consultant for the work.",
  "evidence" => "The decision relied on, or was accompanied by, the target document.",
}
vocab_body = +"<h1>Vocabulary</h1>\n<p>Link types used in this knowledge base beyond the OKF base profile, so the decision graph is self-describing. Each is a <code>rel</code> on a link from the first note to the second; the target shows it as a backlink.</p>\n<dl>\n"
VOCAB.each { |term, desc| vocab_body << %(<dt><dfn id="#{term}"><code>#{term}</code></dfn></dt><dd>#{h.(desc)}</dd>\n) }
vocab_body << "</dl>\n<p>Base-profile terms also in use: <code>chapter</code>, <code>describedby</code>, <code>related</code>, <code>glossary</code>, <code>tag</code>, <code>external</code>.</p>\n"
put("Vocabulary", vocab_body, "reference")

# ---------------------------------------------------------------- organisations
ORGS = {
  "City of Victor Harbor" => ["Local council; proponent of VHITS and decision-maker on it.", "S-A01, S-B03 p.75"],
  "SMEC" => ["Engineering consultant engaged under contract C0000243 (tender CVH058153) for VHITS; wrote the Phase 1 report, proposed the draft Communications and Engagement Plan, provides technical content for the fact sheet, and its logo appears beside the council's on every draft consultation map. Individual staff not named.", "S-B03 pp.77, 79, 87, 89-96, S-B04 p.3, S-B21"],
  "URPS" => ["Planning and engagement consultant: prepared the VHITS fact sheet and survey (2026); sub-consultant on the 2014 Mainstreet plan and the 2017 strategy.", "S-B03 pp.81-87, S-B26, S-B22"],
  "Tonkin Consulting" => ["Traffic consultant for the 2015–17 town-centre investigations, strategy and Torrens Street review. Staff named only by initials (PCS/PS, RB, LS, GM).", "S-B22, S-D19, S-D21"],
  "Department for Infrastructure and Transport" => ["South Australian Government department, the Department for Infrastructure and Transport (DIT), formerly the Department of Planning, Transport and Infrastructure (DPTI). Owns Torrens St, Hindmarsh Rd, Victoria St and other State roads; approves every speed-limit change; engaged by the VHITS team in June 2026.", "S-D17, S-B36 p.115, S-B03 p.82"],
  "HDS Australia" => ["Heavy-vehicle route consultant: 2019 South Coast Freight Corridor assessment; January 2026 presentation to the council's Agribusiness Working Group (an advisory group) on the freight corridor.", "S-B29 p.214, S-B31"],
}
ORGS.each do |name, (desc, ids)|
  put(name, %(<h1>#{h.(name)}</h1>\n<p>#{h.(desc)} #{src.(ids)}</p>\n<p>People, decisions and documents linked to this organisation appear under "Linked from".</p>\n), "organisation,people")
end

