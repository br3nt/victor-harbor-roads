DOCS.each do |title, org, ids, body|
  put(title, %(<h1>#{h.(title)}</h1>\n<p>Author: <a rel="authored-by" href="/n/#{slug.(org)}">#{h.(org)}</a>.</p>\n#{body}), "document,council")
end

