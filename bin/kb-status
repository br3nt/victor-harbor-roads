#!/usr/bin/env python3
"""Set the status of one requirement / expected item in a note body file.

    bin/kb-status FILE ID STATUS LABEL_HTML

Sets data-status="STATUS" on the element with id="ID". For a table row it also
replaces the contents of that row's LAST cell with LABEL_HTML (trusted HTML, may
contain links). Exits non-zero if the element isn't found, or if a row's last
cell couldn't be replaced, so a silent half-update can't happen.
"""
import re
import sys

path, ident, status, label = sys.argv[1:5]
s = open(path, encoding="utf-8").read()

start_tag = re.compile(r'<(tr|li|p)\b[^>]*\bid="%s"[^>]*>' % re.escape(ident))
m = start_tag.search(s)
if not m:
    sys.exit(f"kb-status: no <tr|li|p> with id={ident} in {path}")
tag, open_end = m.group(1), m.end()

opening = m.group(0)
if re.search(r'\bdata-status="[^"]*"', opening):
    new_opening = re.sub(r'\bdata-status="[^"]*"', f'data-status="{status}"', opening, count=1)
else:
    new_opening = opening[:-1] + f' data-status="{status}">'
s = s[:m.start()] + new_opening + s[m.end():]
open_end = m.start() + len(new_opening)

if tag == "tr":
    close = s.find("</tr>", open_end)
    if close == -1:
        sys.exit(f"kb-status: row {ident} has no </tr>")
    row = s[open_end:close]
    cells = list(re.finditer(r"<td\b[^>]*>.*?</td>", row, re.S))
    if not cells:
        sys.exit(f"kb-status: row {ident} has no cells")
    last = cells[-1]
    td_open = re.match(r"<td\b[^>]*>", last.group(0)).group(0)
    row = row[:last.start()] + td_open + label + "</td>" + row[last.end():]
    s = s[:open_end] + row + s[close:]

open(path, "w", encoding="utf-8").write(s)
